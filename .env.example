# run.sh reads this file after you copy it to .env.
ROUTER_HOST=127.0.0.1
ROUTER_PORT=8890
ROUTER_MIN_SCORE=0.62
ROUTER_MIN_MARGIN=0.03
# Portable FP32 ONNX on Mac. For exported Apple Silicon INT8 use:
# ROUTER_ONNX_FILE=onnx/model_qint8_arm64.onnx
ROUTER_ONNX_FILE=onnx/model.onnx
OMP_NUM_THREADS=4
LOG_LEVEL=INFO
# Optional absolute paths (default: this project/model and routes.yaml):
# ROUTER_MODEL_DIR=/absolute/path/to/model
# ROUTER_ROUTES_FILE=/absolute/path/to/routes.yaml
